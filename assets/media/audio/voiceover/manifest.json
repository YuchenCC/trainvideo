[
  {
    "scene": "scene-01-1",
    "start": 0,
    "end": 6.4,
    "duration": 6.4,
    "text": "企业多业务线、多系统并行迭代时，困难不只是写代码，",
    "file": "assets/media/audio/voiceover/scene-01-1.mp3",
    "audioDuration": 5.29,
