    "speed": 1.12,
    "attempt": 0,
    "bytes": 169908
  },
  {
    "scene": "scene-01-3",
    "start": 15.6,
    "end": 28,
    "duration": 12.4,
    "text": "常常带来需求不规范、纳版无依据、变更无约束、沟通无留痕，最终形成版本冲突、风险失控和问题难追溯。",
    "file": "assets/media/audio/voiceover/scene-01-3.mp3",
